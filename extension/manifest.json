{
  "manifest_version": 3,
  "name": "EmoteKit for Twitch",
  "version": "0.6.0",
  "description": "BetterTTV, FrankerFaceZ and 7TV emotes for Twitch chat, with each channel's most used emotes, an emote picker, favourites and hiding",
  "homepage_url": "https://github.com/zyknows/emotekit",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://twitch.tv/*"
      ],
      "js": [
        "emotekit.user.js"
      ],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "https://gql.twitch.tv/*",
    "https://api.ivr.fi/*",
    "https://api.betterttv.net/*",
    "https://api.frankerfacez.com/*",
    "https://7tv.io/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "emotekit@zyknows",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
